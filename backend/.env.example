# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it holds real credentials.

# --- Database ---
# Password for the database user. Letters and digits only (it sits inside a URL).
# Make one with:  python -c "import secrets; print(secrets.token_hex(24))"
DB_PASSWORD=
# Local dev, PostgreSQL in Docker (docker-compose.yml publishes it on port 5433).
# Put the same password in place of <DB_PASSWORD>:
DATABASE_URL=postgresql+psycopg://leo_user:<DB_PASSWORD>@127.0.0.1:5433/leo_db

# --- Document storage ---
# local = this machine's disk (development); gdrive = Legal Office Google Drive
STORAGE_BACKEND=local
# Empty = backend/storage
LOCAL_STORAGE_DIR=
# Google Drive only: service-account JSON key path (outside the repo) and the
# Shared Drive folder ID, both from ESSU IT
GDRIVE_CREDENTIALS_FILE=
GDRIVE_FOLDER_ID=

# --- Outgoing email (SMTP) ---
# Only these values change between the two setups; the code stays the same.
# Port 587 = STARTTLS, port 465 = SSL. LEXIS always logs in with the
# username/password below. Leave SMTP_HOST empty to send no email at all.
#
# A) Until turnover: the interim Gmail sender (a free account, temporary).
#    Turn on 2-Step Verification for the account, then create an App Password
#    (Google Account > Security > App passwords) and paste the 16 characters
#    with no spaces. The normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ESSU Legal Office
# Free Gmail allows about 500 emails a day; LEXIS stops at this number so the
# account is never suspended. Sign-in codes may use at most MAIL_DAILY_CODE_LIMIT
# of it, so status updates to clients always get through.
MAIL_DAILY_LIMIT=300
MAIL_DAILY_CODE_LIMIT=200
#
# B) At turnover: the Legal Office mailbox legaloffice@essu.edu.ph (ESSU Google
#    Workspace). Replace the block above with the values ESSU IT gives you:
#      SMTP_HOST=smtp.gmail.com          (or smtp-relay.gmail.com if IT sets up the relay)
#      SMTP_PORT=587
#      SMTP_USERNAME=legaloffice@essu.edu.ph
#      SMTP_PASSWORD=<App Password or relay password from ESSU IT>
#      MAIL_FROM_ADDRESS=legaloffice@essu.edu.ph
#      MAIL_FROM_NAME=ESSU Legal Office
#      MAIL_DAILY_LIMIT=<keep 300 until ESSU IT confirms the account's daily limit,
#                        then set it safely under that limit>
#      MAIL_DAILY_CODE_LIMIT=<about two-thirds of MAIL_DAILY_LIMIT>
#    Restart LEXIS after changing .env, then send yourself a sign-in code to test.

# Links in emails point here. Development: Caddy on localhost:8080.
# Deployment: the real https address on the ESSU subdomain.
PUBLIC_SITE_URL=http://localhost:8080

# --- Sign-in ---
# 32+ random characters. LEXIS refuses to start outside development without it.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true on the real site (HTTPS), so sign-in cookies are never sent over plain HTTP.
SESSION_COOKIE_SECURE=false

# --- App ---
# development or production. Never development on the real site: it puts
# sign-in codes in API responses and prints them to the log.
ENVIRONMENT=development
# SQL_ECHO=true prints every SQL statement (debugging only).
# TESSERACT_CMD: path to tesseract.exe for the holiday importer, if it is not
# on PATH or in C:\Program Files\Tesseract-OCR.
# CORS_ALLOWED_ORIGINS is not needed: Caddy serves the pages and /api from
# one address. Add it (a JSON list) only if the pages ever move elsewhere.
# TRUSTED_PROXY_IPS: who may pass on the visitor's address (X-Forwarded-For).
# Default '["127.0.0.1", "::1"]' = Caddy on this machine. In Docker behind
# Caddy, the Docker network range, e.g. '["172.16.0.0/12"]'.
# ALLOWED_HOSTS: extra host names besides localhost and PUBLIC_SITE_URL's.
